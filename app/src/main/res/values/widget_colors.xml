<?xml version="1.0" encoding="utf-8"?>
<!-- Light-theme values, matching the v2 "Lux" design doc's own token table (section 1)
     rather than sampled. Glance's ColorProvider only accepts a single Color or a
     resource id — day/night switching has to go through this file's values-night/
     counterpart, matching Android's own resource qualification system, so Glance can
     pick the right one per render automatically. -->
<resources>
    <color name="widget_surface">#FFFFFF</color>
    <color name="widget_silent_surface">#FFFFFF</color>
    <color name="widget_surface2">#EFEAE2</color>
    <color name="widget_text">#191826</color>
    <color name="widget_dim">#94191826</color>
    <color name="widget_faint">#5C191826</color>
    <color name="widget_accent">#4B49A8</color>
    <color name="widget_accent_soft">#1C4B49A8</color>
</resources>
