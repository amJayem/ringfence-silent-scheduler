    <string name="onboarding_quick_silence_finish">Finish</string>

    <string name="exact_alarm_headline">One more permission for on-time silencing.</string>
    <string name="exact_alarm_body">Without exact alarm access, Android may delay turning your sound back on by up to a minute. Allow it so silence windows end exactly when scheduled.</string>
