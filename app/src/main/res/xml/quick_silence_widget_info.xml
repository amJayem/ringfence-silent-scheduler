<?xml version="1.0" encoding="utf-8"?>
<!-- Placed at a 3x1 cell footprint by default — the same row height as the compact
     widget (quick_silence_small_widget_info.xml), not the taller 2-row footprint this
     used to request. The header+chips content already fits a 1-row placement's real
     height comfortably (its gaps are flexible spacers, and the footer only renders
     when there's room to spare), and a shorter card was requested over the extra,
     mostly-empty vertical space the 2-row version left. Width-only resize: only
     width is meant to grow, up to the full screen, so resizeMode omits "vertical".
     maxResizeWidth is set well past any real phone's screen width — the OS clamps
     actual dragging to the physical screen and grid regardless, so the ceiling here
     should never be what stops someone from reaching full screen width themselves. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="124dp"
    android:minHeight="54dp"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:resizeMode="horizontal"
    android:minResizeWidth="124dp"
    android:maxResizeWidth="700dp"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:previewImage="@mipmap/ic_launcher"
    android:initialLayout="@layout/quick_silence_widget_loading" />
