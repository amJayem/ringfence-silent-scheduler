<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".RingfenceApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ringfence">

        <!-- Lets AppCompatDelegate.setApplicationLocales() persist the chosen
             per-app language across process restarts on API < 33, where there's
             no framework LocaleManager to back it. Never started directly. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <receiver
            android:name=".quicksilence.data.SilenceRevertReceiver"
            android:exported="false" />

        <receiver
            android:name=".core.notification.EndSilenceReceiver"
            android:exported="false" />

        <receiver
            android:name=".schedule.data.ScheduleTriggerReceiver"
            android:exported="false" />

        <receiver
            android:name=".schedule.data.BootRescheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Alarms are armed as absolute instants computed from the wall-clock
                     schedule in the zone/time that was current when they were set, so
                     a time zone or clock change leaves every one of them pointing at
                     the wrong moment until they are re-armed. -->
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <!-- An app update stops the process; re-arm without waiting for the
                     user to open the app again. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- Sent when the user grants "Alarms & reminders": re-arm so the
                     pending alarms become exact straight away. -->
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".schedule.data.ScheduleReconciliationReceiver"
            android:exported="false" />

        <receiver
            android:name=".core.reminder.ReviewReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".widget.WidgetTickReceiver"
            android:exported="false" />

        <receiver
            android:name=".widget.QuickSilenceWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_wide_picker_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_silence_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.QuickSilenceSmallWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_small_picker_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_silence_small_widget_info" />
        </receiver>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Ringfence">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
